{
  "title": "Eruldin: Yankilar — design and real 3D asset pack v1",
  "date": "2026-10-05",
  "scope": "Assets/design only. No game source code in this pack. First art slice and detailed 3D blockout, not final LoR-level production polish.",
  "methods": {
    "2D": "Built-in image_gen; lossless PNG atlas extraction",
    "3D": "Blender 4.5.14 LTS, actual geometry and material/keyframe construction, Cycles renders, glTF export"
  },
  "prompts": [
    "sources/initial-manifest.json",
    "sources/prompts-v1.json"
  ],
  "fonts": "Cinzel and Manrope with bundled SIL OFL 1.1 licenses",
  "third_party_game_assets_used": false,
  "meshy_used": false,
  "code_prototype_included": false,
  "limitations": [
    "No final sculpt/hand-painted PBR/UV/LOD pass",
    "No fluid fire/smoke simulation; flames/smoke are animated 3D meshes",
    "2D VFX atlas is static, not a temporal flipbook",
    "All UI screens/states are not complete; AI mockup text must be typeset separately",
    "GLB simplifies Blender procedural bump, compositor and light-intensity animation",
    "Game engine integration/performance not tested"
  ],
